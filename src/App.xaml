<Application x:Class="Fletta.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             ShutdownMode="OnLastWindowClose">
  <Application.Resources>
    <!-- Farben aus dem Mock. ChromeBrush = Titelleiste (CaptionColorRef in MainWindow). -->
    <SolidColorBrush x:Key="CanvasBrush" Color="#141715" />
    <SolidColorBrush x:Key="ChromeBrush" Color="#1B1E1C" />
    <SolidColorBrush x:Key="RaiseBrush" Color="#2A2F2B" />
    <SolidColorBrush x:Key="HoverBrush" Color="#323833" />
    <SolidColorBrush x:Key="LineBrush" Color="#2F3531" />
    <SolidColorBrush x:Key="TextBrush" Color="#DDE3DF" />
    <SolidColorBrush x:Key="MutedBrush" Color="#8A938D" />
    <SolidColorBrush x:Key="PanelBrush" Color="#1F2320" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3CCF80" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#22362B" />

    <!-- Symbole als Strichpfade im 24er-Raster, aus dem Mock übernommen. -->
    <Geometry x:Key="IconOpen">M3 7a2 2 0 0 1 2-2h4l2 2h6a2 2 0 0 1 2 2v1M3 7v10a2 2 0 0 0 2 2h12l3-8H7l-3 8</Geometry>
    <Geometry x:Key="IconPrint">M7 9V4h10v5M7 17H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-2M7 14h10v6H7z</Geometry>
    <Geometry x:Key="IconCopy">M10 8h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2zM16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2</Geometry>
    <Geometry x:Key="IconRotateLeft">M4 4v5h5M4.6 9A8 8 0 1 1 5 15</Geometry>
    <Geometry x:Key="IconRotateRight">M20 4v5h-5M19.4 9A8 8 0 1 0 19 15</Geometry>
    <Geometry x:Key="IconFitWidth">M3 12h18M3 12l3-3M3 12l3 3M21 12l-3-3M21 12l-3 3M8 4h8M8 20h8</Geometry>
    <Geometry x:Key="IconFitPage">M7 3h10a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM9 8h6M9 12h6M9 16h4</Geometry>
    <Geometry x:Key="IconSpreads">M4 5h6a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zM14 5h6a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1h-6a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z</Geometry>
    <Geometry x:Key="IconPaged">M7 3h10a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM12 17v4M9.5 18.5L12 21l2.5-2.5</Geometry>
    <Geometry x:Key="IconHelp">M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18zM9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6V14M12 17.5v.01</Geometry>
    <Geometry x:Key="IconSidebar">M5 4h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zM9 4v16</Geometry>
    <Geometry x:Key="IconMinus">M5 12h14</Geometry>
    <Geometry x:Key="IconPlus">M5 12h14M12 5v14</Geometry>
    <Geometry x:Key="IconPrev">M15 5l-7 7 7 7</Geometry>
    <Geometry x:Key="IconNext">M9 5l7 7-7 7</Geometry>

    <!-- Symbolknopf: Content ist eine der Geometrien oben. Nicht fokussierbar, damit die Tasten
         beim Seitenbereich bleiben; bedienbar ist alles auch über die Tastenkürzel. Auf ButtonBase,
         damit der Umschaltknopf (ToolToggle) dieselbe Vorlage nutzt. -->
    <Style x:Key="ToolButton" TargetType="ButtonBase">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ButtonBase">
            <Border x:Name="Background" Background="{TemplateBinding Background}" CornerRadius="6">
              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Background" Property="Background" Value="{StaticResource HoverBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <Viewbox Width="18" Height="18">
              <Canvas Width="24" Height="24">
                <Path Data="{Binding}" StrokeThickness="1.7" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" />
              </Canvas>
            </Viewbox>
          </DataTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolButton}">
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="Background" Value="{StaticResource SelectedBrush}" />
          <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Reiter der Seitenleiste: Umschaltknopf mit Text statt Symbol. -->
    <Style x:Key="TabToggle" TargetType="ToggleButton" BasedOn="{StaticResource ToolToggle}">
      <Setter Property="Width" Value="Auto" />
      <Setter Property="Height" Value="30" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="ContentTemplate" Value="{x:Null}" />
    </Style>

    <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
      <Setter Property="Width" Value="Auto" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="ContentTemplate" Value="{x:Null}" />
    </Style>

    <Style x:Key="MenuButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Height" Value="30" />
    </Style>

    <Style x:Key="ToolSeparator" TargetType="Rectangle">
      <Setter Property="Width" Value="1" />
      <Setter Property="Height" Value="20" />
      <Setter Property="Margin" Value="6,0" />
      <Setter Property="Fill" Value="{StaticResource LineBrush}" />
    </Style>

    <Style x:Key="Pill" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource ChromeBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="5" />
      <Setter Property="VerticalAlignment" Value="Bottom" />
    </Style>

    <!-- Bildlaufleisten dunkel und schmal statt der hellen von Windows. Implizit, gilt überall.
         Ohne Pfeilknöpfe: Klick in die Bahn blättert, der Griff zieht. -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4B534E" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#6B746E" />

    <Style x:Key="ScrollPageButton" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent" />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="Focusable" Value="False" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="Grip" Background="{StaticResource ScrollThumbBrush}" CornerRadius="4" Margin="3" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Grip" Property="Background" Value="{StaticResource ScrollThumbHoverBrush}" />
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Grip" Property="Background" Value="{StaticResource ScrollThumbHoverBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="{StaticResource CanvasBrush}" />
      <Setter Property="Width" Value="12" />
      <Setter Property="MinWidth" Value="12" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.Resources>
                  <!-- Mindestlänge des Griffs: Track nimmt die Hälfte dieser Systemgröße. Ohne das wird der
                       Griff bei 990 Seiten ein Strich von 2–3 px; mit 56 waren es gemessen ~22 px sichtbar
                       (Test-VM, 2026-09-10), mit 80 also gut 30 px. -->
                  <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">80</sys:Double>
                  <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">80</sys:Double>
                </Track.Resources>
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageUpCommand" />
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageDownCommand" />
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}" />
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto" />
          <Setter Property="MinWidth" Value="0" />
          <Setter Property="Height" Value="12" />
          <Setter Property="MinHeight" Value="12" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Grid Background="{TemplateBinding Background}">
                  <Track x:Name="PART_Track">
                    <Track.Resources>
                      <!-- Mindestlänge des Griffs: Track nimmt die Hälfte dieser Systemgröße. Ohne das wird der
                           Griff bei 990 Seiten ein Strich von 2–3 px; mit 56 waren es gemessen ~22 px sichtbar
                           (Test-VM, 2026-09-10), mit 80 also gut 30 px. -->
                      <sys:Double x:Key="{x:Static SystemParameters.VerticalScrollBarButtonHeightKey}">80</sys:Double>
                      <sys:Double x:Key="{x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}">80</sys:Double>
                    </Track.Resources>
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageLeftCommand" />
                    </Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollPageButton}" Command="ScrollBar.PageRightCommand" />
                    </Track.IncreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb Style="{StaticResource ScrollThumb}" />
                    </Track.Thumb>
                  </Track>
                </Grid>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PageBox" TargetType="TextBox">
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Background" Value="{StaticResource RaiseBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </Application.Resources>
</Application>
