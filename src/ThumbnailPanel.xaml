<UserControl x:Class="Fletta.ThumbnailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <!-- Feste Höhe je Eintrag (ItemHeight): daraus rechnet VisibleRange die sichtbaren Einträge. -->
    <Style x:Key="ThumbItemStyle" TargetType="ListBoxItem">
      <Setter Property="Height" Value="{Binding ItemHeight}" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Card" Background="Transparent" BorderBrush="Transparent" BorderThickness="2"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{StaticResource RaiseBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{StaticResource SelectedBrush}" />
              </Trigger>
              <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
    <Grid>
    <!-- Seiten ziehen, ablegen und per Rechtsklick bearbeiten: siehe OnListPress, OnListDrop, MenuRequested. -->
    <ListBox x:Name="List" SelectionMode="Extended" Background="Transparent" BorderThickness="0"
             ItemContainerStyle="{StaticResource ThumbItemStyle}"
             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
             VirtualizingPanel.ScrollUnit="Pixel" AllowDrop="True"
             ScrollViewer.ScrollChanged="OnListScrolled" PreviewMouseLeftButtonUp="OnListClick"
             PreviewMouseLeftButtonDown="OnListPress" PreviewMouseMove="OnListMove"
             PreviewMouseRightButtonUp="OnListRightClick"
             DragOver="OnListDragOver" DragLeave="OnListDragLeave" Drop="OnListDrop">
      <ListBox.Template>
        <ControlTemplate TargetType="ListBox">
          <!-- Kein senkrechter Innenabstand, sonst stimmt die Rechnung Offset / ItemHeight nicht. -->
          <ScrollViewer x:Name="ListScroller" Focusable="False" CanContentScroll="True"
                        HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Visible">
            <ItemsPresenter Margin="6,0" />
          </ScrollViewer>
        </ControlTemplate>
      </ListBox.Template>
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Label}" Foreground="{StaticResource MutedBrush}"
                       FontSize="12" Height="18" Margin="0,4,0,0" HorizontalAlignment="Center" />
            <Grid Width="{Binding BoxSize}" Height="{Binding BoxSize}">
              <Border Background="White" Width="{Binding ShownWidth}" Height="{Binding ShownHeight}"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                <Image Source="{Binding Bitmap}" Stretch="Fill" LayoutTransform="{Binding Turn}" />
              </Border>
            </Grid>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <!-- Einfügemarke beim Ablegen: eine Linie in der Lücke zwischen zwei Miniaturen. -->
    <Canvas IsHitTestVisible="False" ClipToBounds="True">
      <Rectangle x:Name="DropMarker" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{StaticResource AccentBrush}" Visibility="Collapsed" />
    </Canvas>
    </Grid>
  </Border>
</UserControl>
